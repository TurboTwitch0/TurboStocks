    const filtered =
        lessons.filter(lesson =>

            currentLessonFilter === "all" ||
            lesson.category ===
            currentLessonFilter

        );


    box.innerHTML =
        filtered.map(lesson => {

            const completed =
                lessonProgress[
                    lesson.id
                ]?.completed;


            return `
                <article
                    class="lesson-card ${
                        completed
                            ? "completed"
                            : ""
                    }"
                >

                    <div class="lesson-category">
                        ${lesson.category}
                    </div>

                    <h3>
                        ${escapeHTML(
                            lesson.title
                        )}
                    </h3>

                    <p>
                        ${escapeHTML(
                            lesson.description
                        )}
                    </p>

                    <p>
                        ${
                            completed
                                ? "✓ Completed"
                                : "Not completed"
                        }
                    </p>

                    <button
                        class="primary"
                        onclick="openLesson('${lesson.id}')"
                    >
                        ${
                            completed
                                ? "Review"
                                : "Start Lesson"
                        }
                    </button>

                </article>
            `;

        }).join("");

}


function filterLessons(
    category,
    button
) {

    currentLessonFilter =
        category;


    document
        .querySelectorAll(".learn-tabs button")
        .forEach(btn =>
            btn.classList.remove("active")
        );


    if (button) {
        button.classList.add("active");
    }


    renderLessons();

}


function updateLessonProgress() {

    const total =
        lessons.length;


    const completed =
        lessons.filter(
            lesson =>
                lessonProgress[
                    lesson.id
                ]?.completed
        ).length;


    const percent =
        Math.round(
            completed /
            total *
            100
        );


    if ($("learnProgressText")) {

        $("learnProgressText")
            .textContent =
            `${percent}%`;

    }


    if ($("learnProgressBar")) {

        $("learnProgressBar")
            .style.width =
            `${percent}%`;

    }


    if ($("homeProgressText")) {

        $("homeProgressText")
            .textContent =
            `${percent}% complete`;

    }


    if ($("homeProgressBar")) {

        $("homeProgressBar")
            .style.width =
            `${percent}%`;

    }

}


function openLesson(id) {

    selectedLesson =
        lessons.find(
            lesson =>
                lesson.id === id
        );


    if (!selectedLesson) return;


    $("lessonCategory")
        .textContent =
        selectedLesson.category;


    $("lessonTitle")
        .textContent =
        selectedLesson.title;


    $("lessonBody")
        .innerHTML =
        selectedLesson.body;


    $("quizArea")
        .innerHTML =
        `
            <h3>
                Knowledge Check
            </h3>

            ${
                selectedLesson.quiz
                    .map(
                        (question,index) => `

                        <div class="quiz-question">

                            <h4>
                                ${index + 1}.
                                ${escapeHTML(
                                    question.question
                                )}
                            </h4>

                            <div class="quiz-choices">

                                ${
                                    question.choices
                                        .map(
                                            (choice,
                                             choiceIndex) => `

                                            <label>

                                                <input
                                                    type="radio"
                                                    name="quiz${index}"
                                                    value="${choiceIndex}"
                                                >

                                                ${escapeHTML(
                                                    choice
                                                )}

                                            </label>
                                        `
                                        )
                                        .join("")
                                }

                            </div>

                        </div>
                    `
                    )
                    .join("")
            }

            <button
                class="primary wide"
                onclick="submitQuiz()"
            >
                Submit Quiz
            </button>

            <div id="quizResult"></div>
        `;


    $("lessonModal")
        .style.display =
        "flex";

}


function closeLesson() {

    $("lessonModal")
        .style.display =
        "none";

    selectedLesson = null;

}


function submitQuiz() {

    if (!selectedLesson) return;


    let score = 0;


    selectedLesson.quiz
        .forEach(
            (question,index) => {

                const selected =
                    document.querySelector(
                        `input[name="quiz${index}"]:checked`
                    );


                if (
                    selected &&
                    Number(
                        selected.value
                    ) ===
                    question.answer
                ) {

                    score++;

                }

            }
        );


    const total =
        selectedLesson.quiz.length;


    const percent =
        Math.round(
            score /
            total *
            100
        );


    const passed =
        percent >= 70;


    lessonProgress[
        selectedLesson.id
    ] = {

        completed:
            passed,

        score,

        total,

        percent,

        date:
            new Date()
                .toISOString()

    };


    saveEverything();

    updateLessonProgress();

    renderLessons();


    $("quizResult")
        .innerHTML =
        `
            <div class="${
                passed
                    ? "quiz-success"
                    : "quiz-failure"
            }">

                <h3>
                    ${
                        passed
                            ? "Lesson complete!"
                            : "Review and try again."
                    }
                </h3>

                <p>
                    Score:
                    ${score}/${total}
                    (${percent}%)
                </p>

            </div>
        `;

}


