function toggleWatchlist(symbol) {

    if (
        account.watchlist
            .includes(symbol)
    ) {

        account.watchlist =
            account.watchlist
                .filter(
                    x => x !== symbol
                );

    } else {

        account.watchlist.push(symbol);

    }


    saveEverything();

    renderWatchlist();

    renderStocks();

}


