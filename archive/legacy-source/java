        $("stockList");

    if (!list) return;


    const query =
        (
            $("marketSearch")?.value ||
            ""
        )
        .trim()
        .toUpperCase();


    const results =
        Object.values(stocks)
            .filter(stock =>

                stock.symbol.includes(query) ||
                stock.name
                    .toUpperCase()
                    .includes(query)

            );


    list.innerHTML =
        results.map(stock => {

            const watched =
                account.watchlist
