function aiEnter(event) {

    if (
        event.key === "Enter" &&
        !event.shiftKey
    ) {

        event.preventDefault();

        sendAI();

    }

}


async function sendAI(
    optionalMessage = null,
    imageData = null
) {

    const input =
        $("aiInput");


    const message =
        optionalMessage ||
        input.value.trim();


    if (!message && !imageData) {
        return;
    }


    if (message) {

        addChatMessage(
            "user",
            message
        );

        input.value = "";

    }


    const loading =
        addChatMessage(
            "assistant",
            "Nova is thinking..."
        );


    try {

        const response =
            await fetch(
                `${BACKEND_URL}/api/ai`,
                {

                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json"
                    },

                    body:
                        JSON.stringify({

                            message:
                                message ||
                                "Analyze this image.",

                            symbol:
                                currentSymbol,

                            portfolio:
                                account.positions,

                            profile,

                            image:
                                imageData

                        })

                }
            );


        if (!response.ok) {

            throw new Error(
                `AI server returned ${response.status}`
            );

        }


        const data =
            await response.json();


        loading.remove();


        addChatMessage(
            "assistant",
            data.answer ||
            "Nova did not return an answer."
        );


    } catch(error) {

        loading.remove();


        addChatMessage(
            "assistant",

            `I couldn't reach the AI backend.

Check that backend.js is running and BACKEND_URL in app.js is correct.

Error: ${error.message}`
        );

    }

}


function addChatMessage(
    role,
    text
) {

    const chat =
        $("chat");


    const bubble =
        document.createElement(
            "div"
        );


    bubble.className =
        `bubble ${role}`;


    bubble.innerHTML =
        `
            <b>
                ${
                    role === "user"
                        ? "You"
                        : "Nova"
                }
            </b>

            <p>
                ${formatAI(text)}
            </p>
        `;


    chat.appendChild(
        bubble
    );


    chat.scrollTop =
        chat.scrollHeight;


    return bubble;

}


function formatAI(text) {

    return escapeHTML(text)
        .replace(
            /\*\*(.*?)\*\*/g,
            "<strong>$1</strong>"
        )
        .replace(
            /^## (.*?)$/gm,
            "<h3>$1</h3>"
        )
        .replace(
            /\n/g,
            "<br>"
        );

}


/* =========================================================
   IMAGE ANALYSIS
========================================================= */

function analyzeImage(input) {

    const file =
        input.files[0];

    if (!file) return;


    if (
        ![
            "image/png",
            "image/jpeg",
            "image/webp"
        ].includes(file.type)
    ) {

        alert(
            "Please choose a PNG, JPG or WebP image."
        );

        return;

    }


    const reader =
        new FileReader();


    reader.onload =
        async function() {

            const imageData =
                reader.result;


            showPage("ai");


            addChatMessage(
                "user",
                `I uploaded a chart/image for ${currentSymbol}. Explain what I should study from it.`
            );


            await sendAI(
                `Analyze this ${currentSymbol} chart/image educationally. Identify visible chart features, indicators, trend context, bullish/bearish possibilities, uncertainty, and what additional information should be checked before making a paper-trading decision. Do not guarantee a result or execute a trade.`,
                imageData
            );

        };


    reader.readAsDataURL(file);

}


/* =========================================================
   GLOBAL SEARCH
========================================================= */

function globalSearch() {

    const input =
        $("globalSearch");


    const resultsBox =
        $("searchResults");


    const query =
        input.value
            .trim()
            .toLowerCase();


    if (!query) {

        resultsBox.style.display =
            "none";

        return;

    }


    const stockResults =
        Object.values(stocks)
            .filter(stock =>
                stock.symbol
                    .toLowerCase()
                    .includes(query) ||
                stock.name
                    .toLowerCase()
                    .includes(query)
            )
            .map(stock => ({
                type: "stock",
                title:
                    `${stock.symbol} — ${stock.name}`,
                action:
                    () =>
                        openStock(
                            stock.symbol
                        )
            }));


    const lessonResults =
        lessons
            .filter(lesson =>
                lesson.title
                    .toLowerCase()
                    .includes(query) ||
                lesson.category
                    .toLowerCase()
                    .includes(query)
            )
            .map(lesson => ({
                type: "lesson",
                title:
                    `Lesson — ${lesson.title}`,
                action:
                    () => {
                        showPage("learn");
                        openLesson(
                            lesson.id
                        );
                    }
            }));


    const tools = [

        {
            title: "Markets",
            action:
                () => showPage("markets")
        },

        {
            title: "Learn",
            action:
                () => showPage("learn")
        },

        {
            title: "News",
            action:
                () => showPage("news")
        },

        {
            title: "Nova AI",
            action:
                () => showPage("ai")
        },

        {
            title: "Portfolio",
            action:
                () => showPage("portfolio")
        }

    ]
    .filter(tool =>
        tool.title
            .toLowerCase()
            .includes(query)
    )
    .map(tool => ({
        type: "tool",
        ...tool
    }));


    const results =
        [
            ...stockResults,
            ...lessonResults,
            ...tools
        ]
        .slice(0,8);


    if (!results.length) {

        resultsBox.innerHTML =
            `
                <div class="search-result">
                    No results
                </div>
            `;

    } else {

        resultsBox.innerHTML =
            results.map(
                (result,index) => `

                    <div
                        class="search-result"
                        onclick="runSearchResult(${index})"
                    >

                        ${escapeHTML(
                            result.title
                        )}

                    </div>
                `
            ).join("");

    }


    window.searchResultActions =
        results.map(
            result =>
                result.action
        );


    resultsBox.style.display =
        "block";

}


function runSearchResult(index) {

    const action =
        window.searchResultActions?.[
            index
        ];


    if (action) {

        action();

    }


    $("searchResults")
        .style.display =
        "none";

}


