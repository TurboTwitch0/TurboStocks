/* =========================================================
   PORTFOLIO
========================================================= */

function renderPortfolio() {

    const positions =
        $("positions");

    if (!positions) return;


    let invested = 0;


    const symbols =
        Object.keys(
            account.positions
        );


    if (!symbols.length) {

        positions.innerHTML = `
            <div class="small">
                No paper positions yet.
                Study a company first, then use
                your paper-trading workflow.
            </div>
        `;

    } else {

        positions.innerHTML =
            symbols.map(symbol => {

                const position =
                    account.positions[symbol];

                const stock =
                    stocks[symbol];

                if (!stock) return "";


                const value =
                    stock.price *
                    position.shares;


                const cost =
                    position.averagePrice *
                    position.shares;


                const pnl =
                    value - cost;


                invested += cost;


                return `
                    <div class="position-row">

                        <strong>
                            ${symbol}
                        </strong>

                        <span>
                            ${position.shares} shares
                        </span>

                        <span>
                            Avg ${money(
                                position.averagePrice
                            )}
                        </span>

                        <span class="${
                            pnl >= 0
                                ? "positive"
                                : "negative"
                        }">

                            ${
                                pnl >= 0
                                    ? "+"
                                    : ""
                            }${money(pnl)}

                        </span>

                    </div>
                `;

            }).join("");

    }


    $("portfolioValue").textContent =
        money(getPortfolioValue());


    $("buyingPower").textContent =
        money(account.cash);


    $("investedValue").textContent =
        money(invested);


    $("positionCount").textContent =
        symbols.length;


    renderTradeHistory();

}


function renderTradeHistory() {

    const box =
        $("tradeHistory");

    if (!box) return;


    if (!account.history.length) {

        box.innerHTML =
            "<p class='small'>No trades yet.</p>";

        return;

    }


    box.innerHTML =
        account.history
            .slice(0,25)
            .map(trade => {

                return `
                    <div class="history-row">

                        <strong>
                            ${escapeHTML(
                                trade.side
                            )}
                        </strong>

                        <span>
                            ${escapeHTML(
                                trade.symbol
                            )}
                        </span>

                        <span>
                            ${trade.shares} shares
                        </span>

                        <span>
                            ${money(
                                trade.price
                            )}
                        </span>

                    </div>
                `;

            })
            .join("");

}


