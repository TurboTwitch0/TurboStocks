function updateDashboard() {

    const value =
        getPortfolioValue();


    if ($("homePortfolio")) {

        $("homePortfolio")
            .textContent =
            money(value);

    }


    renderWatchlist();

    updateLessonProgress();

}


function getPortfolioValue() {

    let total =
        account.cash;


    Object.entries(
        account.positions
    ).forEach(
        ([symbol, position]) => {

            const stock =
                stocks[symbol];

            if (!stock) return;

            total +=
                stock.price *
                position.shares;

        }
    );


    return total;

}


