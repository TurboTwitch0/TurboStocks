:root {
    --bg: #070b14;
    --panel: #0d1422;
    --panel2: #111b2d;
    --text: #f4f7fb;
    --muted: #8e9bb0;
    --border: #1d2a40;
    --accent: #2f7cff;
    --accent2: #62a0ff;
    --green: #36d399;
    --red: #ff647c;
    --shadow: 0 20px 60px rgba(0,0,0,.25);
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    background:
        radial-gradient(
            circle at 10% 0%,
            rgba(47,124,255,.13),
            transparent 30%
        ),
        var(--bg);
    color: var(--text);
    font-family:
        Inter,
        Arial,
        Helvetica,
        sans-serif;
}

button,
input,
textarea {
    font: inherit;
}

button {
    cursor: pointer;
}

.topbar {
    position: sticky;
    top: 0;
    z-index: 100;
    min-height: 72px;
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 12px 28px;
    background: rgba(7,11,20,.88);
    backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--border);
}

.brand {
    color: var(--text);
    text-decoration: none;
    font-size: 20px;
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 9px;
    white-space: nowrap;
}

.brand-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 20px var(--accent);
}

.global-search {
    position: relative;
    flex: 1;
    max-width: 430px;
}

.global-search span {
    position: absolute;
    left: 13px;
    top: 9px;
    color: var(--muted);
}

.global-search input,
.inline-search input,
.modal-box input {
    width: 100%;
    background: var(--panel);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 12px;
    outline: none;
    padding: 11px 14px 11px 38px;
}

.inline-search input {
    padding-left: 14px;
}

.global-search input:focus,
.inline-search input:focus,
.modal-box input:focus,
textarea:focus {
    border-color: var(--accent);
}

.search-results {
    position: absolute;
    top: 48px;
    left: 0;
    right: 0;
    display: none;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--shadow);
}

.search-result {
    padding: 12px 15px;
    border-bottom: 1px solid var(--border);
}

.search-result:hover {
    background: var(--panel2);
}

nav {
    display: flex;
    gap: 3px;
}

nav button,
.learn-tabs button {
    border: 0;
    color: var(--muted);
    background: transparent;
    padding: 9px 11px;
    border-radius: 9px;
}

nav button:hover,
nav button.active,
.learn-tabs button:hover,
.learn-tabs button.active {
    color: var(--text);
    background: var(--panel2);
}

.icon-btn,
.profile-btn {
    border: 1px solid var(--border);
    background: var(--panel);
    color: var(--text);
    border-radius: 10px;
    padding: 9px 12px;
}

.profile-btn {
    white-space: nowrap;
}

main {
    width: min(1500px, 94%);
    margin: auto;
}

.page {
    display: none;
    padding: 50px 0 80px;
}

.page.active {
    display: block;
}

.hero {
    min-height: 570px;
    display: grid;
    grid-template-columns: 1.35fr .65fr;
    align-items: center;
    gap: 50px;
}

.eyebrow {
    color: var(--accent2);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .14em;
}

.hero h1 {
    margin: 16px 0;
    font-size: clamp(45px, 6vw, 86px);
    line-height: .96;
    letter-spacing: -.055em;
}

.hero h1 span {
    color: var(--accent2);
}

.hero p {
    max-width: 700px;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.7;
}

.hero-actions {
    display: flex;
    gap: 12px;
    margin-top: 28px;
}

.primary,
.secondary {
    border-radius: 11px;
    padding: 12px 17px;
    font-weight: 750;
}

.primary {
    border: 1px solid var(--accent);
    color: white;
    background: var(--accent);
}

.secondary {
    border: 1px solid var(--border);
    color: var(--text);
    background: var(--panel);
}

.primary:hover {
    filter: brightness(1.12);
}

.hero-card {
    padding: 35px;
    border: 1px solid var(--border);
    background:
        linear-gradient(
            145deg,
            rgba(47,124,255,.15),
            rgba(13,20,34,.96)
        );
    border-radius: 25px;
    box-shadow: var(--shadow);
}

.quote-mark {
    font-size: 90px;
    color: var(--accent2);
    line-height: .7;
}

.hero-card h3 {
    font-size: 28px;
    line-height: 1.25;
}

.hero-card p {
    font-size: 14px;
}

.section-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 25px;
}

.section-head h2 {
    margin: 8px 0;
    font-size: 38px;
}

.section-head p {
    color: var(--muted);
}

.feature-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    margin-bottom: 25px;
}

.feature,
.card,
.study-card,
.stat {
    background: rgba(13,20,34,.9);
    border: 1px solid var(--border);
    border-radius: 18px;
}

.feature {
    padding: 25px;
}

.feature b {
    color: var(--accent2);
}

.feature h3 {
    margin-bottom: 8px;
}

.feature p,
.study-card p {
    color: var(--muted);
    line-height: 1.6;
}

.dashboard-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
}

.card {
    padding: 22px;
    box-shadow: 0 10px 35px rgba(0,0,0,.08);
}

.card-title,
.chart-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
}

.card-title button,
.chart-head button {
    border: 0;
    background: transparent;
    color: var(--accent2);
}

.big-number {
    font-size: 34px;
    font-weight: 850;
    margin-top: 20px;
}

.progress-wrap {
    width: 100%;
    height: 9px;
    background: var(--panel2);
    border-radius: 99px;
    overflow: hidden;
}

.progress {
    height: 100%;
    width: 0;
    background: linear-gradient(
        90deg,
        var(--accent),
        var(--accent2)
    );
    border-radius: inherit;
    transition: width .5s ease;
}

.market-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 16px;
}

.chart-card {
    min-width: 0;
}

.tv-chart {
    height: 610px;
    margin-top: 18px;
    border-radius: 12px;
    overflow: hidden;
}

.stock-list-card {
    max-height: 650px;
    overflow: auto;
}

.stock-item {
    padding: 14px;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
}

.stock-item:hover {
    background: var(--panel2);
}

.stock-item-top,
.stock-item-bottom {
    display: flex;
    justify-content: space-between;
    gap: 10px;
}

.stock-item-bottom {
    margin-top: 7px;
    color: var(--muted);
    font-size: 13px;
}

.positive {
    color: var(--green) !important;
}

.negative {
    color: var(--red) !important;
}

.widget-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 16px;
}

.tv-widget {
    min-height: 390px;
    margin-top: 15px;
    overflow: hidden;
    border-radius: 12px;
}

.news-height {
    min-height: 550px;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    margin-bottom: 16px;
}

.stat {
    padding: 20px;
}

.stat span {
    display: block;
    color: var(--muted);
    margin-bottom: 8px;
}

.stat strong {
    font-size: 25px;
}

.table-list > div,
.position-row,
.history-row {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 1fr;
    gap: 15px;
    padding: 15px 0;
    border-bottom: 1px solid var(--border);
}

.learn-tabs {
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
    margin-bottom: 20px;
}

.learning-dashboard {
    padding: 20px;
    margin-bottom: 20px;
    border: 1px solid var(--border);
    background: var(--panel);
    border-radius: 16px;
}

.learning-dashboard > div:first-child {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
}

.lesson-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
}

.lesson-card {
    padding: 24px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 18px;
    transition: .2s;
}

.lesson-card:hover {
    transform: translateY(-3px);
    border-color: rgba(47,124,255,.6);
}

.lesson-card.completed {
    border-color: rgba(54,211,153,.55);
}

.lesson-category {
    color: var(--accent2);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
}

.lesson-card p {
    color: var(--muted);
    line-height: 1.6;
}

.lesson-card button {
    margin-top: 10px;
}

.article-grid {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 16px;
    margin-top: 16px;
}

.study-card {
    padding: 25px;
}

.study-card span {
    color: var(--accent2);
    font-size: 11px;
    font-weight: 800;
}

.ai-layout {
    display: grid;
    grid-template-columns: 1fr 310px;
    gap: 16px;
}

.ai-chat-card {
    min-height: 650px;
    display: flex;
    flex-direction: column;
}

.chat {
    flex: 1;
    min-height: 500px;
    max-height: 590px;
    overflow: auto;
    padding-right: 8px;
}

.bubble {
    max-width: 85%;
    margin-bottom: 14px;
    padding: 14px 17px;
    border-radius: 15px;
    background: var(--panel2);
    line-height: 1.6;
}

.bubble.user {
    margin-left: auto;
    background: var(--accent);
}

.bubble p {
    margin: 7px 0 0;
}

.chat-input {
    display: flex;
    gap: 10px;
    margin-top: 15px;
}

.chat-input textarea {
    flex: 1;
    resize: vertical;
    min-height: 60px;
    max-height: 180px;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 13px;
    color: var(--text);
    background: var(--panel);
    outline: none;
}

.ai-tools {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.ai-tools button,
.upload-btn {
    padding: 13px;
    border-radius: 11px;
    border: 1px solid var(--border);
    color: var(--text);
    background: var(--panel2);
    text-align: left;
}

.ai-tools button:hover,
.upload-btn:hover {
    border-color: var(--accent);
}

.upload-btn input {
    display: none;
}

.small {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
}

.modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 500;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(0,0,0,.72);
}

.modal-box {
    width: min(500px,100%);
    max-height: 90vh;
    overflow: auto;
    padding: 28px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 20px;
    box-shadow: var(--shadow);
    position: relative;
}

.modal-box input {
    margin: 7px 0;
    padding-left: 14px;
}

.close {
    position: absolute;
    right: 15px;
    top: 12px;
    border: 0;
    background: transparent;
    color: var(--muted);
    font-size: 28px;
}

.wide {
    width: 100%;
    margin-top: 10px;
}

.lesson-modal {
    width: min(850px,100%);
}

.lesson-body {
    line-height: 1.8;
    color: #dce4f2;
}

.lesson-body h2,
.lesson-body h3 {
    color: var(--text);
}

.formula {
    padding: 15px;
    margin: 15px 0;
    border-radius: 10px;
    background: var(--panel2);
    color: var(--accent2);
    font-family: monospace;
}

.quiz-question {
    margin: 20px 0;
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: 13px;
}

.quiz-choices {
    display: grid;
    gap: 9px;
}

.quiz-choices label {
    padding: 10px;
    background: var(--panel2);
    border-radius: 8px;
}

.quiz-success,
.quiz-failure {
    padding: 15px;
    margin-top: 15px;
    border-radius: 12px;
}

.quiz-success {
    background: rgba(54,211,153,.12);
    border: 1px solid rgba(54,211,153,.35);
}

.quiz-failure {
    background: rgba(255,100,124,.12);
    border: 1px solid rgba(255,100,124,.35);
}

footer {
    width: min(1500px,94%);
    margin: auto;
    padding: 30px 0 45px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    color: var(--muted);
}

body.light {
    --bg: #f4f7fb;
    --panel: #ffffff;
    --panel2: #edf2f9;
    --text: #101827;
    --muted: #617089;
    --border: #dbe3ef;
}

body.light .topbar {
    background: rgba(244,247,251,.9);
}

@media (max-width: 1100px) {

    .topbar {
        flex-wrap: wrap;
    }

    nav {
        order: 5;
        width: 100%;
        overflow-x: auto;
    }

    .hero {
        grid-template-columns: 1fr;
    }

    .feature-grid {
        grid-template-columns: repeat(2,1fr);
    }

    .market-layout {
        grid-template-columns: 1fr;
    }

    .lesson-grid,
    .article-grid {
        grid-template-columns: repeat(2,1fr);
    }

}

@media (max-width: 750px) {

    .topbar {
        padding: 12px 15px;
    }

    .global-search {
        order: 4;
        max-width: none;
        flex-basis: 100%;
    }

    .hero h1 {
        font-size: 48px;
    }

    .feature-grid,
    .dashboard-grid,
    .widget-grid,
    .stats-grid,
    .lesson-grid,
    .article-grid,
    .ai-layout {
        grid-template-columns: 1fr;
    }

    .section-head {
        align-items: flex-start;
        flex-direction: column;
    }

    .tv-chart {
        height: 480px;
    }

    .table-list > div,
    .position-row,
    .history-row {
        grid-template-columns: 1fr 1fr;
    }

    footer {
        flex-direction: column;
        gap: 10px;
    }

}